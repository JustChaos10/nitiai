# Retention Reasoning Agent - Environment Variables
# Copy this file to .env and fill in your actual values

# Required: Groq API key for LLM access
# Get one at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Required: Thesys API key for C1 chat UI
# Get one at https://thesys.dev
THESYS_API_KEY=your_thesys_api_key_here

# Optional: Groq model settings
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.2
GROQ_MAX_OUTPUT=4096

# Optional: Logging level
LOG_LEVEL=INFO

# Optional: CORS settings (comma-separated origins)
CORS_ALLOW_ORIGINS=*

